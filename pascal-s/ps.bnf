# ================================================================
# PASCAL-S

# ================================================================
# LEXER RULES

# TODO: Write up: sharp edge if this isn't first b/c first-found & it matches identifier
program ::= "program";

#relational_op ::= "=" | "<>" | "<" | "<=" | ">=" | ">" ;
#adding_op ::= "+" | "-" | "or" ;
multiplying_op ::= "*" | "/" | "div" | "mod" | "and" ;

!whitespace ::= ' ' | '\t' | '\n' | '\r' ;
_letter ::= "a"-"z" | "A"-"Z";
_digit  ::= "0"-"9";

_idchar ::= _letter | _digit | "_" | "." | "+" | "-" | "*"| "/"| "*"| "*"| "*";
identifier ::= _idchar { _idchar };

unsigned_number ::= _digit { _digit };

# XXX TEMP
# unsigned_const ::= unsigned_number | identifier | string-literal ;
unsigned_const ::= unsigned_number;

# ================================================================
# PARSER RULES

# ----------------------------------------------------------------
# Program Structure
# xxx temp
Program ::= "program" identifier;
#Program ::= "program" identifier "(" IdentifierList ")" ";" Block "." ;
#Block ::= [ConstantDefPart] [TypeDefPart] [VarDefPart] [ProcDefPart] CompoundStatement ;

constant ::= unsigned_const | ["+" | "-"] identifier ;
IdentifierList ::= identifier {"," identifier} ;
#VariableList ::= Variable {"," Variable} ;
#ExpressionList ::= Expression {"," Expression} ;

# ----------------------------------------------------------------
# Declarations
ConstantDefPart ::= "const" ConstantDef {ConstantDef} ;
ConstantDef ::= identifier "=" constant ";" ;
#TypeDefPart ::= "type" TypeDef {TypeDef} ;
#TypeDef ::= identifier "=" NewType ";" ;
#VarDefPart ::= "var" VarDef {VarDef} ;
#VarDef ::= IdentifierList ":" TypeDenoter ";" ;
#ProcDefPart ::= {ProcedureDecl | FunctionDecl} ;

# ----------------------------------------------------------------
# Types
#NewType ::= SimpleType | ArrayType | RecordType ;
#SimpleType ::= "integer" | "boolean" | "char" | "real" ;
#ArrayType ::= "array" "[" index-range "]" "of" TypeDenoter ;
#index-range ::= constant ".." constant ;
#RecordType ::= "record" FieldList "end" ;
#FieldList ::= RecordSection {";" RecordSection} ;
#RecordSection ::= IdentifierList ":" TypeDenoter ;
#TypeDenoter ::= identifier | NewType ;

# ----------------------------------------------------------------
# Procedures and Functions
#ProcedureDecl ::= "procedure" identifier [FormalParams] ";" Block ";" ;
#FunctionDecl ::= "function" identifier [FormalParams] ":" SimpleType ";" Block ";" ;
#FormalParams ::= "(" FormalParamSection {";" FormalParamSection} ")" ;
#FormalParamSection ::= ["var"] IdentifierList ":" TypeDenoter ;

# ----------------------------------------------------------------
# Statements
#statement ::= [AssignmentStatement | ProcStatement | CompoundStatement | IfStatement | WhileStatement | ReadStatement | WriteStatement] ;
#AssignmentStatement ::= Variable ":=" Expression ;
#ProcStatement ::= identifier ["(" ActualParamList ")"] ;
#CompoundStatement ::= "begin" statement {";" statement} "end" ;
#IfStatement ::= "if" Expression "then" statement ["else" statement] ;
#WhileStatement ::= "while" Expression "do" statement ;
#ReadStatement ::= "read" "(" VariableList ")" ;
#WriteStatement ::= "write" "(" ExpressionList ")" ;

# ----------------------------------------------------------------
# Expressions
#Expression ::= SimpleExpression [relational_op SimpleExpression] ;
#SimpleExpression ::= ["+" | "-"] Term {AddingOp Term} ;
#Term ::= Factor {multiplying_op Factor} ;
#Factor ::= identifier | unsigned_const | "(" Expression ")" | "not" Factor | Variable ;
#Variable ::= identifier {"[" Expression "]" | "." identifier} ;
